# Copy to .env and replace every placeholder. Do not commit .env.
# Use a URL-safe password so it can be embedded in DATABASE_URL.

HOST=127.0.0.1
PORT=8080
RUST_LOG=sentinelforge=info,tower_http=info

POSTGRES_USER=sentinelforge
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sentinelforge
DATABASE_URL=postgres://sentinelforge:change-me@127.0.0.1:5432/sentinelforge

# Comma-separated keys. Writes always require one. Minimum length is 16.
API_KEYS=replace-with-a-long-random-key
REQUIRE_READ_AUTH=false
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
BODY_LIMIT_BYTES=2097152
RATE_LIMIT_PER_SECOND=10
RATE_LIMIT_BURST=30

GEOIP_CITY_DB=./data/GeoLite2-City.mmdb
GEOIP_ASN_DB=./data/GeoLite2-ASN.mmdb
MAXMIND_LICENSE_KEY=

ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
ALIENVAULT_OTX_API_KEY=

# HoneyTrap collector. Private addresses are rejected unless this is true.
HONEYTRAP_API_URL=http://127.0.0.1:9100
HONEYTRAP_ALLOW_PRIVATE=true
HONEYTRAP_EVENTS_FILE=./events.jsonl

# Browser-facing API origin and the key the dashboard sends as X-API-Key.
# The key is visible to anyone who can load the UI.
VITE_API_BASE=http://127.0.0.1:8080
VITE_API_KEY=replace-with-a-long-random-key
